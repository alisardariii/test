<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F3EA" android:fillViewport="true">
<LinearLayout android:id="@+id/page" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/hdr" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="44dp" android:paddingBottom="26dp">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_launcher"
            android:padding="0dp" android:scaleType="fitCenter" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="14dp">
            <TextView android:tag="b" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="گزارش زنده" android:textColor="#FFFFFF" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="رادرس · سیستم مدیریت رستوران" android:textColor="#F2C46B" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp">

        <!-- راهنما -->
        <LinearLayout android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
            <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="اضافه کردن ویجت" android:textColor="#0B3F36" android:textSize="17sp" android:layout_marginBottom="6dp" />
        </LinearLayout>

        <!-- مجموعه‌ها -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="14dp">
            <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="مجموعه‌ها" android:textColor="#0B3F36" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="برای هر مجموعه (رستوران، هتل، …) لینک «داده‌ی خام» صفحه‌ی /widget داشبوردش را اضافه کنید. روی هر مجموعه بزنید تا ویرایش شود."
                android:textColor="#5B6A64" android:textSize="13sp" />
            <LinearLayout android:id="@+id/sites_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/form_title" android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="افزودن مجموعه" android:textColor="#0F5C4D" android:textSize="15sp" />
            <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/field" android:padding="14dp"
                android:hint="اسم مجموعه (مثلاً هفت‌خوان)" android:textColor="#1D2B27" android:textColorHint="#93A099" android:textSize="14sp" android:inputType="text" />
            <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/field" android:padding="14dp"
                android:hint="http://…/w/….json" android:textColor="#1D2B27" android:textColorHint="#93A099"
                android:textSize="14sp" android:textDirection="ltr" android:inputType="textUri" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
                <TextView android:id="@+id/save" android:gravity="center" android:clickable="true" android:focusable="true" android:tag="b"
                    android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="50dp" android:background="@drawable/btn_primary"
                    android:text="ذخیره و امتحان" android:textColor="#2A1C00" android:textSize="15sp" />
                <TextView android:id="@+id/paste" android:gravity="center" android:clickable="true" android:focusable="true"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_marginStart="10dp"
                    android:background="@drawable/btn_ghost" android:text="چسباندن لینک" android:textColor="#0F5C4D" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="12dp" android:textSize="14sp" android:visibility="gone" />
        </LinearLayout>

        <!-- هشدارها -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="14dp">
            <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="هشدارها" android:textColor="#0B3F36" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="هر ۱۵ دقیقه بررسی می‌شود و برای هر مورد فقط یک بار پیغام می‌آید."
                android:textColor="#5B6A64" android:textSize="13sp" />
            <Switch android:id="@+id/al_tables" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:thumbTint="#E3A12F"
                android:text="میزی بیشتر از حد مجاز نشسته" android:textColor="#1D2B27" android:textSize="15sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حد مجاز (دقیقه):"
                    android:textColor="#5B6A64" android:textSize="14sp" />
                <EditText android:id="@+id/al_min" android:layout_width="90dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:background="@drawable/field" android:padding="10dp" android:gravity="center" android:inputType="number"
                    android:textColor="#1D2B27" android:textSize="14sp" />
            </LinearLayout>
            <Switch android:id="@+id/al_watch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:thumbTint="#E3A12F"
                android:text="نگهبان صندوق: حذف فیش، تخفیف بعد از چاپ، پرداخت تکراری" android:textColor="#1D2B27" android:textSize="15sp" />
            <Switch android:id="@+id/al_taraz" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:thumbTint="#E3A12F"
                android:text="آخر شب تراز صندوق صفر نشده" android:textColor="#1D2B27" android:textSize="15sp" />
        </LinearLayout>

        <!-- رفتار ویجت -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="14dp">
            <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="با زدن روی ویجت" android:textColor="#0B3F36" android:textSize="17sp" />
            <RadioGroup android:id="@+id/tap" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/tapOpen" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:buttonTint="#E3A12F"
                    android:text="گزارش زنده باز شود" android:textColor="#1D2B27" android:textSize="15sp" />
                <RadioButton android:id="@+id/tapRefresh" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:buttonTint="#E3A12F"
                    android:text="فقط اطلاعات تازه شود (چیزی باز نشود)" android:textColor="#1D2B27" android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- به‌روزرسانی -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="14dp">
            <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="به‌روزرسانی برنامه" android:textColor="#0B3F36" android:textSize="17sp" />
            <TextView android:id="@+id/ver" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#5B6A64" android:textSize="13sp" />
            <TextView android:id="@+id/upd" android:tag="b" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginTop="12dp" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/btn_ghost" android:text="بررسی نسخه‌ی جدید" android:textColor="#0F5C4D" android:textSize="15sp" />
            <TextView android:id="@+id/updres" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:padding="12dp" android:textSize="14sp" android:visibility="gone" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="رادرس — سیستم مدیریت رستوران"
            android:textColor="#93A099" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
