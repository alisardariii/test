<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <!-- ═════════ صفحه‌ی اصلی ═════════ -->
    <ScrollView android:id="@+id/pg_home" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="22dp" android:paddingBottom="14dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_launcher" android:scaleType="fitCenter" />
            <TextView android:tag="b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:text="رادرس" android:textColor="@color/c_head" android:textSize="23sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/hero" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/hero_name" android:tag="b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="1" />
                <TextView android:id="@+id/hero_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/hero_btn" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                    android:textColor="#FFFFFF" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="فروش امشب" android:textColor="#CFE3DA" android:textSize="13sp" />
            <TextView android:id="@+id/hero_amt" android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="32sp" android:maxLines="1" />
            <TextView android:id="@+id/hero_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFC2B8" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="14dp" android:baselineAligned="false">
                <TextView android:id="@+id/refresh_now" android:tag="b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                    android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/hero_btn2"
                    android:text="تازه کن" android:textColor="#1A1405" android:textSize="15sp" />
                <TextView android:id="@+id/hero_open" android:tag="b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                    android:layout_marginStart="10dp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/hero_btn"
                    android:text="باز کردن گزارش" android:textColor="#FFFFFF" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/perm_warn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/chip_bad" android:textColor="@color/c_badfg"
            android:textSize="13sp" android:visibility="gone" android:clickable="true" android:focusable="true" />

        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:layout_marginStart="6dp" android:text="آخرین هشدار" android:textColor="@color/c_mut" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:layout_marginTop="6dp">
            <LinearLayout android:id="@+id/last_alert" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/c_line" />
            <LinearLayout android:id="@+id/row_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/rowsel" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/row_log_t" android:tag="b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="همه‌ی هشدارها" android:textColor="@color/c_acc" android:textSize="14sp" />
                <TextView android:id="@+id/row_log_n" android:tag="b" android:layout_width="wrap_content" android:layout_height="22dp" android:minWidth="22dp"
                    android:gravity="center" android:background="@drawable/cnt" android:paddingLeft="7dp" android:paddingRight="7dp"
                    android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginEnd="10dp" android:visibility="gone" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chev" android:tint="@color/c_chev" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:layout_marginStart="6dp" android:text="تنظیمات" android:textColor="@color/c_mut" android:textSize="13sp" />
        <LinearLayout android:id="@+id/menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:layout_marginTop="6dp" />

        <TextView android:id="@+id/ver" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="18dp" android:textColor="@color/c_hint" android:textSize="12sp" />
    </LinearLayout>
    </ScrollView>

    <!-- ═════════ مجموعه‌ها ═════════ -->
    <ScrollView android:id="@+id/pg_sites" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="20dp">
        <TextView android:tag="hdr" android:text="مجموعه‌ها" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="هر مجموعه یک رستوران یا هتل است، با لینک «داده‌ی خام» صفحه‌ی ‎/widget‎ داشبوردش." android:textColor="@color/c_text2" android:textSize="13sp" />
        <LinearLayout android:id="@+id/status_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/sites_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/add_site" android:tag="b" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/btn_ghost"
            android:text="+  افزودن مجموعه" android:textColor="@color/c_acc" android:textSize="15sp" android:layout_marginTop="12dp" />
        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone"
            android:background="@drawable/grp" android:padding="16dp">
            <TextView android:id="@+id/form_title" android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="مجموعه‌ی جدید" android:textColor="@color/c_acc" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="اسم" android:textColor="@color/c_text2" android:textSize="13sp" />
            <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/field" android:padding="12dp"
                android:hint="مثلاً هفت‌خوان" android:textColor="@color/c_text" android:textColorHint="@color/c_hint" android:textSize="14sp" android:inputType="text" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:layout_marginTop="10dp" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="لینک داده‌ی خام" android:textColor="@color/c_text2" android:textSize="13sp" />
                <TextView android:id="@+id/paste" android:tag="b" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:clickable="true" android:focusable="true" android:padding="4dp"
                    android:text="📋 چسباندن" android:textColor="@color/c_acc" android:textSize="13sp" />
            </LinearLayout>
            <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/field" android:padding="12dp"
                android:hint="http://…/w/….json" android:textColor="@color/c_text" android:textColorHint="@color/c_hint"
                android:textSize="13sp" android:textDirection="ltr" android:inputType="textUri" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
                <TextView android:id="@+id/save" android:tag="b" android:gravity="center" android:clickable="true" android:focusable="true"
                    android:layout_width="0dp" android:layout_height="48dp" android:background="@drawable/btn_primary"
                    android:text="ذخیره" android:textColor="#2A1C00" android:textSize="15sp" android:layout_weight="1.5" />
                <TextView android:id="@+id/cancel" android:tag="b" android:gravity="center" android:clickable="true" android:focusable="true"
                    android:layout_width="0dp" android:layout_height="48dp" android:background="@drawable/btn_ghost"
                    android:text="انصراف" android:textColor="@color/c_acc" android:textSize="15sp" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:padding="12dp" android:textSize="14sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- ═════════ هشدارها ═════════ -->
    <ScrollView android:id="@+id/pg_alerts" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="20dp">
        <TextView android:tag="hdr" android:text="هشدارها" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:paddingLeft="16dp" android:paddingRight="16dp">
            <Switch android:id="@+id/al_tables" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="14dp" android:paddingBottom="4dp" android:text="میز بیش از حد مجاز نشسته" android:textColor="@color/c_text" android:textSize="15sp" />
            <LinearLayout android:id="@+id/min_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
                <SeekBar android:id="@+id/al_min" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:thumb="@drawable/sl_thumb" android:splitTrack="false" android:max="18" />
                <LinearLayout android:id="@+id/ticks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/c_line" />
            <Switch android:id="@+id/al_watch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="14dp" android:paddingBottom="14dp" android:text="نگهبان صندوق\nحذف فیش، تخفیف بعد از چاپ، پرداخت تکراری" android:textColor="@color/c_text" android:textSize="15sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/c_line" />
            <Switch android:id="@+id/al_taraz" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="14dp" android:paddingBottom="14dp" android:text="تراز صفر نشده (آخر شب)" android:textColor="@color/c_text" android:textSize="15sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/c_line" />
            <Switch android:id="@+id/al_sum" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="14dp" android:paddingBottom="14dp" android:text="خلاصه‌ی فروش امشب" android:textColor="@color/c_text" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
            android:text="هر تغییر همان لحظه ذخیره می‌شود." android:textColor="@color/c_hint" android:textSize="12sp" />
        <TextView android:id="@+id/al_test" android:tag="b" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/grp"
            android:text="ارسال هشدار آزمایشی" android:textColor="@color/c_acc" android:textSize="15sp" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/al_res" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:padding="12dp" android:textSize="14sp" android:visibility="gone" />
        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:layout_marginStart="6dp" android:text="تاریخچه" android:textColor="@color/c_mut" android:textSize="13sp" />
        <LinearLayout android:id="@+id/log_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/grp" android:layout_marginTop="6dp" />
    </LinearLayout>
    </ScrollView>

    <!-- ═════════ ظاهر ویجت ═════════ -->
    <ScrollView android:id="@+id/pg_look" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="20dp">
        <TextView android:tag="hdr" android:text="ظاهر" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="تم برنامه" android:textColor="@color/c_mut" android:textSize="13sp" />
        <LinearLayout android:id="@+id/theme_seg" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:background="@drawable/seg_bg" android:padding="4dp" android:layout_marginTop="6dp" android:baselineAligned="false" />
        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:text="ویجت" android:textColor="@color/c_mut" android:textSize="13sp" />
        <FrameLayout android:id="@+id/wall" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp">
            <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="190dp" android:scaleType="fitCenter" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:layout_marginTop="14dp" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شفافیت پس‌زمینه" android:textColor="@color/c_text" android:textSize="15sp" />
            <SeekBar android:id="@+id/op_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                android:thumb="@drawable/sl_thumb" android:splitTrack="false" android:max="1000" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="شفاف" android:textColor="@color/c_mut" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="کدر" android:textColor="@color/c_mut" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/font_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:layout_marginTop="14dp">
            <LinearLayout android:id="@+id/font_dd" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/rowsel" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فونت" android:textColor="@color/c_text" android:textSize="15sp" />
                <TextView android:id="@+id/font_cur" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:gravity="left" android:textColor="@color/c_head" android:textSize="19sp" android:maxLines="1" />
                <TextView android:id="@+id/font_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:text="" android:textColor="@color/c_mut" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/font_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
        </LinearLayout>
        <TextView android:tag="b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:layout_marginStart="6dp" android:text="با زدن روی ویجت" android:textColor="@color/c_mut" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:background="@drawable/seg_bg" android:padding="4dp" android:layout_marginTop="6dp" android:baselineAligned="false">
            <TextView android:id="@+id/tapOpen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:text="گزارش باز شود" android:textColor="@color/c_mut" android:textSize="14sp" />
            <TextView android:id="@+id/tapRefresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
                android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" android:text="فقط تازه شود" android:textColor="@color/c_mut" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/grp" android:layout_marginTop="14dp" android:paddingLeft="16dp" android:paddingRight="16dp">
            <Switch android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="14dp" android:paddingBottom="14dp"
                android:text="حالت مخفی\nمبلغ‌ها پنهان؛ با زدن روی ویجت ۳۰ ثانیه دیده می‌شوند" android:textColor="@color/c_text" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center"
            android:text="هر تغییر همان لحظه روی ویجت اعمال می‌شود." android:textColor="@color/c_hint" android:textSize="12sp" />
    </LinearLayout>
    </ScrollView>

    <!-- ═════════ راهنما ═════════ -->
    <ScrollView android:id="@+id/pg_guide" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="20dp">
        <TextView android:tag="hdr" android:text="راه‌اندازی ویجت" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/guide_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
