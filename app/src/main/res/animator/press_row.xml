 <item android:state_pressed="true"><set><objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:duration="90" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" /><objectAnimator android:propertyName="scaleY" android:valueTo="0.985" android:duration="90" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" /></set></item>
 <item><set><objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="160" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" /><objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="160" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" /></set></item>
